[Unit]
Description=Montessori Blog Weekly WhatsApp-ready Digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/carlos/montessori-blog-automation/run_weekly_digest.sh
WorkingDirectory=/home/carlos/montessori-blog-automation
TimeoutStartSec=300
Environment=HOME=/home/carlos

[Install]
WantedBy=default.target
