[Unit]
Description=Montessori Daily WhatsApp Status Suggestion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/carlos/montessori-blog-automation/run_daily_status.sh
WorkingDirectory=/home/carlos/montessori-blog-automation
TimeoutStartSec=300
Environment=HOME=/home/carlos

[Install]
WantedBy=default.target
